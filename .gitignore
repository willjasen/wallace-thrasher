
.DS_Store
**/.DS_Store
*.code-workspace
jekyll/_site/*
!jekyll/_site/.gitkeep
# Generated during each Jekyll production build.
jekyll/assets/json/data.combined.json
/.vscode
**/__pycache__/
node_modules/
package-lock.json
# Local Netlify folder
.netlify
# Local secrets — never commit
.env

# Twilio source is tracked; credentials remain local.
/twilio/.env

# Whisper-WebUI analyses: retain the useful transcription and provenance files
# while excluding generated, duplicated, and local operational artifacts.
/analysis/whisper-webui/**
!/analysis/whisper-webui/README.md
!/analysis/whisper-webui/best-before-24/
!/analysis/whisper-webui/longmont-potion-castle-7/
!/analysis/whisper-webui/best-before-24/*/
!/analysis/whisper-webui/longmont-potion-castle-7/*/
!/analysis/whisper-webui/best-before-24/*/*/
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/
!/analysis/whisper-webui/best-before-24/*/*/README.md
!/analysis/whisper-webui/best-before-24/*/*/manifest.json
!/analysis/whisper-webui/best-before-24/*/*/review.json
!/analysis/whisper-webui/best-before-24/*/*/candidate-subtitles.json
!/analysis/whisper-webui/best-before-24/*/*/comparison.json
!/analysis/whisper-webui/best-before-24/*/*/merge-receipts/
!/analysis/whisper-webui/best-before-24/*/*/merge-receipts/*.json
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/README.md
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/manifest.json
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/review.json
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/candidate-subtitles.json
!/analysis/whisper-webui/longmont-potion-castle-7/*/*/comparison.json
