[
  {
    "Index": 1,
    "Start Time": "00:00:00,000",
    "End Time": "00:00:02,680",
    "Speaker": "Alex Trebek",
    "Text": "Hello?"
  },
  {
    "Index": 2,
    "Start Time": "00:00:03,600",
    "End Time": "00:00:04,000",
    "Speaker": "LPC",
    "Text": "Howdy."
  },
  {
    "Index": 3,
    "Start Time": "00:00:04,520",
    "End Time": "00:00:06,520",
    "Speaker": "LPC",
    "Text": "Yeah. Uh, this is, uh, Dusty"
  },
  {
    "Index": 4,
    "Start Time": "00:00:07,000",
    "End Time": "00:00:09,100",
    "Speaker": "LPC",
    "Text": "with DHL. We've been tryin' to get through, sir,"
  },
  {
    "Index": 5,
    "Start Time": "00:00:09,100",
    "End Time": "00:00:13,940",
    "Speaker": "LPC",
    "Text": "and no one's answered the bell each and every time we've been out there."
  },
  {
    "Index": 6,
    "Start Time": "00:00:15,560",
    "End Time": "00:00:19,480",
    "Speaker": "LPC",
    "Text": "So [echoes] ... do you have any explanation?"
  },
  {
    "Index": 7,
    "Start Time": "00:00:20,940",
    "End Time": "00:00:23,840",
    "Speaker": "Alex Trebek",
    "Text": "Uh, no, we've been home for the past two days, Dusty,"
  },
  {
    "Index": 8,
    "Start Time": "00:00:23,940",
    "End Time": "00:00:27,560",
    "Speaker": "Alex Trebek",
    "Text": "And what's the, uh, delivery? Is it a package, is it an envelope, or...?"
  },
  {
    "Index": 9,
    "Start Time": "00:00:28,000",
    "End Time": "00:00:28,780",
    "Speaker": "LPC",
    "Text": "It's a pouch."
  },
  {
    "Index": 10,
    "Start Time": "00:00:28,780",
    "End Time": "00:00:30,260",
    "Speaker": "Alex Trebek",
    "Text": "A pouch?"
  },
  {
    "Index": 11,
    "Start Time": "00:00:30,820",
    "End Time": "00:00:32,620",
    "Speaker": "LPC",
    "Text": "Yeah, yeah, yeah, yeah."
  },
  {
    "Index": 12,
    "Start Time": "00:00:32,620",
    "End Time": "00:00:35,460",
    "Speaker": "Alex Trebek",
    "Text": "And... and there's money to be paid, uh, for it?"
  },
  {
    "Index": 13,
    "Start Time": "00:00:35,640",
    "End Time": "00:00:36,600",
    "Speaker": "LPC",
    "Text": "COD, yes, sir."
  },
  {
    "Index": 14,
    "Start Time": "00:00:37,240",
    "End Time": "00:00:37,560",
    "Speaker": "Alex Trebek",
    "Text": "Really?"
  },
  {
    "Index": 15,
    "Start Time": "00:00:38,320",
    "End Time": "00:00:38,600",
    "Speaker": "LPC",
    "Text": "Mm-hmm."
  },
  {
    "Index": 16,
    "Start Time": "00:00:39,220",
    "End Time": "00:00:44,020",
    "Speaker": "Alex Trebek",
    "Text": "Oh. Well, that sounds kinda strange 'cause I called DHL after I spoke with you,"
  },
  {
    "Index": 17,
    "Start Time": "00:00:44,020",
    "End Time": "00:00:48,620",
    "Speaker": "Alex Trebek",
    "Text": "uh, uh, yesterday, or—I guess it was early yesterday—and"
  },
  {
    "Index": 18,
    "Start Time": "00:00:49,080",
    "End Time": "00:00:53,700",
    "Speaker": "Alex Trebek",
    "Text": "they said that, uh, if there's ever COD to be paid,"
  },
  {
    "Index": 19,
    "Start Time": "00:00:53,820",
    "End Time": "00:00:55,360",
    "Speaker": "Alex Trebek",
    "Text": "the office calls first, so..."
  },
  {
    "Index": 20,
    "Start Time": "00:00:56,960",
    "End Time": "00:00:58,300",
    "Speaker": "LPC",
    "Text": "Well, that's what I'm doin'."
  },
  {
    "Index": 21,
    "Start Time": "00:00:58,780",
    "End Time": "00:01:01,940",
    "Speaker": "Alex Trebek",
    "Text": "Yeah? Are you at the office or are you the delivery man?"
  },
  {
    "Index": 22,
    "Start Time": "00:01:02,340",
    "End Time": "00:01:04,180",
    "Speaker": "LPC",
    "Text": "'[I was educated in your world."
  },
  {
    "Index": 23,
    "Start Time": "00:01:04,560",
    "End Time": "00:01:11,500",
    "Speaker": "LPC",
    "Text": "All you got is your DVD movies, goin' to the cinema, waging wars -"
  },
  {
    "Index": 24,
    "Start Time": "00:01:12,020",
    "End Time": "00:01:13,420",
    "Speaker": "LPC",
    "Text": "that's all you have.]'"
  },
  {
    "Index": 25,
    "Start Time": "00:01:14,020",
    "End Time": "00:01:14,880",
    "Speaker": "Alex Trebek",
    "Text": "And you're an idiot."
  }
]
